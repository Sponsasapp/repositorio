# Sponsas — variáveis de ambiente
# Copie para .env.local (dev) e configure as mesmas no Vercel (produção).

# --- Supabase (obrigatório) ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Service role — SÓ no servidor, nunca com prefixo NEXT_PUBLIC_.
# Usado por: notificações de e-mail (resolve o e-mail do usuário) e o cron do rank.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Dev: http://localhost:3000 | Prod: https://sponsas.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- E-mail transacional (Resend) ---
# Sem essa chave as notificações não são enviadas (fail-soft, não quebra nada).
RESEND_API_KEY=

# --- YouTube Data API (opcional) ---
# Google Cloud > YouTube Data API v3 > API key. Sem ela o botão "Puxar dados
# do canal" só avisa que não está configurado; o resto do perfil funciona.
YOUTUBE_API_KEY=

# --- Cron do Rank (opcional) ---
# O Vercel define CRON_SECRET automaticamente e manda no header Authorization.
# Se estiver setada, a rota /api/cron/rank-snapshot exige o bearer token.
CRON_SECRET=

# --- Pagamentos (Asaas) ---
# Chave da conta Asaas PRINCIPAL (a plataforma). Sem ela as rotas
# /api/asaas/* respondem 503 e o resto do site funciona normal.
ASAAS_API_KEY=
# Override da base da API. Default = sandbox (https://api-sandbox.asaas.com/v3).
# Produção: https://api.asaas.com/v3
ASAAS_API_BASE=
# Token do header `asaas-access-token` configurado no painel de webhooks do
# Asaas. Se setado, o webhook exige que bata.
ASAAS_WEBHOOK_TOKEN=

# --- Instagram / TikTok OAuth (futuro, ainda não implementado) ---
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
