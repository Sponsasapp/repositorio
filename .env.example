# Supabase — copie para .env.local e preencha com os valores do seu projeto
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — usada no servidor para notificações (resolver e-mail em
# auth.users). NUNCA expor no cliente, NUNCA commitar.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — envio de e-mails transacionais (notificações)
RESEND_API_KEY=

# URL pública do site (usada nos links de confirmação de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
